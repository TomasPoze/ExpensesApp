<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ExpensesApp.Core.Models;assembly=ExpensesApp.Core"
             x:Class="ExpensesApp.MAUI.Views.PieChartView">

    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">

        <GraphicsView x:Name="ChartGraphicsView"
                      Grid.Column="0"
                      WidthRequest="140"
                      HeightRequest="140"
                      HorizontalOptions="Start"
                      VerticalOptions="Center"
                      Margin="20,0,0,0" />

        <CollectionView Grid.Column="1"
                        x:Name="LegendList"
                        ItemsSource="{Binding Items}"
                        VerticalOptions="Center"
                        SelectionMode="None"
                        Margin="30,0,0,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SpendingCategory">
                    <Grid ColumnDefinitions="Auto, Auto, Auto" ColumnSpacing="8">

                        <BoxView Grid.Column="0"
                                 Color="{Binding Color}"
                                 HeightRequest="15"
                                 WidthRequest="15"
                                 CornerRadius="5"
                                 VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               TextColor="White"
                               FontSize="15"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />

                        <Label Grid.Column="2"
                               Text="{Binding PercentageText}"
                               TextColor="Gray"
                               FontSize="15"
                               VerticalOptions="Center" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentView>