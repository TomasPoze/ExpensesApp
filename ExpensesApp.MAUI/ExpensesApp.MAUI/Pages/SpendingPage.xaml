<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="using:ExpensesApp.MAUI.Views"
             x:Class="ExpensesApp.MAUI.Pages.SpendingPage">
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*">

            <views:HeaderView x:Name="HeaderViewControl" Grid.Row="0" />
            <views:PieChartView x:Name="PieChartViewControl" HeightRequest="200" WidthRequest="200" Grid.Row="1"/>
        </Grid>
    </ContentPage.Content>
</ContentPage>