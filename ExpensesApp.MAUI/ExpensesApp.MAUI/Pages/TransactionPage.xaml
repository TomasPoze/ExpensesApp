<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ExpensesApp.MAUI.Views"
             xmlns:viewModels="clr-namespace:ExpensesApp.MAUI.PageModels"
             xmlns:models="clr-namespace:Android.Accounts;assembly=Mono.Android"
             x:Class="ExpensesApp.MAUI.Pages.TransactionPage"
             x:DataType="viewModels:TransactionPageModel"
             BackgroundColor="#111111">
    
    <Grid RowDefinitions="Auto, *">
        <views:HeaderView x:Name="HeaderViewControl" Grid.Row="0" />
        <VerticalStackLayout Padding="20" Grid.Row="1">
            <views:AccountSectionView BindingContext="{Binding AccountSection}"  />

        </VerticalStackLayout>
    </Grid>
</ContentPage>