<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="using:ExpensesApp.MAUI.PageModels"
             x:Class="ExpensesApp.MAUI.Pages.BudgetPage"
             x:DataType="pageModels:BudgetPageModel"
             BackgroundColor="#111"
             >
    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *" RowSpacing="10" Padding="20">
            <Border
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0"
                BackgroundColor="#1E1E1E"
                Padding="15,10">
                <VerticalStackLayout>
                    <Label Text="Budget" TextColor="White" FontSize="16" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>