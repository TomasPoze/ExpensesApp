<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ExpensesApp.MAUI.PageModels"
             xmlns:viewModels="clr-namespace:ExpensesApp.MAUI.ViewModels"
             xmlns:models="clr-namespace:ExpensesApp.Core.Models;assembly=ExpensesApp.Core"
             xmlns:views="clr-namespace:ExpensesApp.MAUI.Views"
             xmlns:converters="clr-namespace:ExpensesApp.MAUI.Converters"
             x:Class="ExpensesApp.MAUI.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             BackgroundColor="#111111">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PercentageToProgressConverter x:Key="PercentageToProgressConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <views:HeaderView x:Name="HeaderViewControl" Grid.Row="0" />


        <ScrollView Grid.Row="1" x:Name="MainScrollView" Scrolled="MainScrollView_Scrolled">
            <VerticalStackLayout Padding="20">

                <views:AccountSectionView BindingContext="{Binding AccountSection}" />
                
                <!-- Income spent section -->
                <Border BackgroundColor="#222"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSpendingCommand}"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout>
                        <Label Text="Income spent" FontAttributes="Bold" FontSize="18" TextColor="White" />
                        <Label Text="{Binding IncomeSpentText}"
                               FontSize="16"
                               TextColor="White" />

                        <ProgressBar
                            Progress="{Binding SpentPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                            ProgressColor="Green" />
                    </VerticalStackLayout>
                </Border>

                    
               
                <Border BackgroundColor="#222"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        Margin="0,10"
                        >
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSpendingCommand}"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Spending"
                                   FontAttributes="Bold"
                                   FontSize="20"
                                   TextColor="White" />
                            <Label Text="{Binding CurrentMonthYear}"
                                   Grid.Column="1"
                                   FontSize="15"
                                   TextColor="#ccc" />
                        </Grid>

                        <!-- Pie chart -->
                        <views:PieChartView Items="{Binding Expenses}" HeightRequest="200" WidthRequest="300" />


                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>


        </ScrollView>
    </Grid>

</ContentPage>