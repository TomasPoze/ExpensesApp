<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:ExpensesApp.MAUI.PageModels"
             xmlns:models="clr-namespace:ExpensesApp.Core.Models;assembly=ExpensesApp.Core"
             xmlns:views="clr-namespace:ExpensesApp.MAUI.Views"
             xmlns:converters="clr-namespace:ExpensesApp.MAUI.Converters"
             x:Class="ExpensesApp.MAUI.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             BackgroundColor="#111111">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PercentageToProgressConverter x:Key="PercentageToProgressConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <views:HeaderView x:Name="HeaderViewControl" Grid.Row="0" />


        <ScrollView Grid.Row="1" x:Name="MainScrollView" Scrolled="MainScrollView_Scrolled">
            <VerticalStackLayout Padding="20">

                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#222" Padding="15" Margin="0,10">
                    <VerticalStackLayout>
                        <Label Text="Accounts" FontSize="20" FontAttributes="Bold" TextColor="White" />

                        <CollectionView ItemsSource="{Binding Accounts}" Margin="0,5">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Account">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding AccountName}" TextColor="White" FontSize="17" />
                                        <Label Text="{Binding Balance, StringFormat='{0} €'}"
                                               TextColor="White" FontSize="17"
                                               HorizontalOptions="End" Grid.Column="1" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Button Text="+ Add Account"
                                Command="{Binding AddAccountCommand}"
                                BackgroundColor="#444"
                                TextColor="White"
                                CornerRadius="10"
                                FontSize="14"
                                Padding="8,4"
                                HorizontalOptions="Center"
                                Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Income spent section -->
                <Border BackgroundColor="#222"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">

                    <VerticalStackLayout >

                        
                            <Label Text="Income spent" FontAttributes="Bold" FontSize="18" TextColor="White" />
                            <Label Text="{Binding IncomeSpentText}"
                                   FontSize="16"
                                   TextColor="White"/>
                       

                        <Slider
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding SpentPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                            HeightRequest="6"
                            ThumbColor="Transparent"
                            MaximumTrackColor="#333"
                            MinimumTrackColor="#5cd" />

                    </VerticalStackLayout>
                </Border>
                
                <Border BackgroundColor="#222"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        Margin="0,10"
                        >

                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Spending" 
                                   FontAttributes="Bold" 
                                   FontSize="20"
                                   TextColor="White"/>
                            <Label Text="March 2024" 
                                   Grid.Column="1" 
                                   FontSize="14" 
                                   TextColor="#ccc"/>
                        </Grid>

                        <!-- Pie chart -->
                        <views:PieChartView x:Name="PieChartViewControl" HeightRequest="200" WidthRequest="200"/>

                        
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
            
            

        </ScrollView>
    </Grid>

</ContentPage>